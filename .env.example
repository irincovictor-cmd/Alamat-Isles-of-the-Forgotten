# Copy to .env (never commit .env). Real environment variables override this file.
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed when served over HTTPS on a real domain, e.g. https://alamat.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# DJANGO_DB_PATH=/var/lib/alamat/db.sqlite3
# ALAMAT_LOGIN_MAX_FAILURES=8
# ALAMAT_LOGIN_LOCKOUT_SECONDS=300
